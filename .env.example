# 复制为 .env 并按需填写；切勿提交 .env。生产用真正的密钥管理（Vault / KMS / K8s Secret）。

# ===== 模型（百炼 / DashScope，必填）=====
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ===== Redis 会话持久化（session.mode=redis 时）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MySQL 会话持久化（session.mode=mysql 时）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_scope_customer_work
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== Nacos 配置中心（nacos.enabled=true 时）=====
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ===== 管理后台 LDAP/AD 单点登录（customer-admin-server）=====
# 是否启用 SSO 登录入口
ADMIN_LDAP_ENABLED=false
# AD 域控地址，如 ldap://domain:123
ADMIN_LDAP_URL=
# UPN 域名后缀（含 @），如 @com.cn
ADMIN_LDAP_DOMAIN_SUFFIX=

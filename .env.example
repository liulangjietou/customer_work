# 复制为 .env 并按需填写；切勿提交 .env。生产用真正的密钥管理（Vault / KMS / K8s Secret）。

# ===== 运行环境 =====
# compose 默认 local；生产必须显式 prod，且所有下方生产密钥都不能留空或使用示例值。
SPRING_PROFILES_ACTIVE=local

# ===== 模型（百炼 / DashScope，必填）=====
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ===== Redis 会话持久化（session.mode=redis 时）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== MySQL 会话持久化（session.mode=mysql 时）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_scope_customer_work
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== 接口与身份凭证（prod 必填）=====
AUTH_ENABLED=true
AUTH_API_KEYS=replace-with-at-least-one-api-key
CW_USER_JWT_SECRET=replace-with-at-least-32-random-characters
CW_AGENT_WS_SECRET=replace-with-at-least-32-random-characters
# 审批 token→操作员映射请通过 secrets yml 或标准 Spring Map 环境变量注入，例如：
# CUSTOMER_WORK_SECURITY_APPROVAL_AUTH_OPERATORS_TOKEN_A=operator-a

# ===== MinIO 文件存储（附件/头像，prod 必填且禁止使用 minioadmin）=====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== Nacos 配置中心（nacos.enabled=true 时）=====
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ===== 管理后台 LDAP/AD 单点登录（customer-admin-server）=====
# 是否启用 SSO 登录入口
ADMIN_LDAP_ENABLED=false
# AD 域控地址，如 ldap://domain:123
ADMIN_LDAP_URL=
# UPN 域名后缀（含 @），如 @com.cn
ADMIN_LDAP_DOMAIN_SUFFIX=

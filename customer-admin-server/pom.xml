<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.richardfyoung</groupId>
        <artifactId>customer-work-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>customer-admin-server</artifactId>
    <packaging>jar</packaging>
    <name>customer-admin-server</name>
    <description>智能体客服后台管理系统：用户权限（RBAC）/ AI 模型 / MCP / Skill / 智能体管理，
        支持在线聊天与 VibeCoding（Spring MVC）</description>

    <properties>
        <!-- SFTP 客户端：JSch 官方已停更，改用社区维护版 mwiede/jsch（同 com.jcraft.jsch 包 API）；
             版本只在本模块声明，不动根 pom。 -->
        <jsch.version>0.2.23</jsch.version>
    </properties>

    <dependencies>
        <!-- 显式覆盖父 POM 继承下来的 commons-lang3:3.13.0（dependency:tree -Dverbose 证实来自某个
             上游 BOM 的仲裁结果）——agentscope-harness 的 Docker 沙箱工作区投影（WorkspaceProjectionApplier
             用 tar 归档同步文件到容器）依赖 commons-compress，commons-compress 用到的
             org.apache.commons.lang3.ArrayFill 是 commons-lang3 3.14.0 才新增的类，3.13.0 下
             直接 NoClassDefFoundError。只在本模块覆盖，不动根 pom 的 dependencyManagement（避免
             影响其它模块的既有版本锁定）。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!-- Spring MVC（非 WebFlux）：与 customer-channel 同一手法接入 starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- RBAC 权限框架（需求文档技术选型锁定） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 仅取密码哈希工具（BCryptPasswordEncoder），不引入 spring-boot-starter-security 的
             自动装配（会与 Sa-Token 的鉴权流程冲突），版本随 spring-boot-starter-parent 统一管理 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ORM（需求文档技术选型锁定），带 spring-boot3-starter 自动装配 DataSource/SqlSessionFactory -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 数据库迁移：本地/测试 profile 自动建表，生产 flyway.enabled=false 走 DBA 手工执行 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MySQL 驱动（HikariCP 随 mybatis-plus-spring-boot3-starter 传递） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 复用本项目 Agent 能力（模型层/工具/Skill/状态存储等叶子类，运行时动态智能体工厂使用）。
             排除 springdoc-webflux-ui：本模块是 Spring MVC，避免与 starter 的 webflux Swagger 冲突。
             starter 的 WebFlux 自动装配在本模块以 spring.autoconfigure.exclude 关闭，仅复用 web 无关类。 -->
        <dependency>
            <groupId>io.github.richardfyoung</groupId>
            <artifactId>customer-work-spring-boot-starter</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 历史对话列表读缓存（ChatHistoryCache）直接用 Jedis API；已经通过 starter 传递可用，
             这里显式声明，版本随 starter 统一管理，不在本模块重复固定版本号。 -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <!-- 定时任务 XXL-JOB 执行器（ScheduledTaskJobHandler 直接用 xxl-job-core API）；
             已经通过 starter 传递可用（starter 引入 agentscope-extensions-scheduler-xxl-job），
             这里显式声明便于直接引用其类。agentscope-bom 未管理该版本（同 starter pom 的坑），
             需与 starter 保持一致的显式版本号。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>3.3.2</version>
        </dependency>

        <!-- SQL 查询结果导出 xlsx（SqlQueryController#export）。项目原本无 POI，EasyExcel 传递
             引入 poi/poi-ooxml 4.1.2；选本地仓库已存在的稳定版 3.3.2，避免额外下载/版本冲突。 -->
        <!-- SQL 查询结果导出 xlsx。easyexcel 必须用 4.x（基于 POI 5.x）：starter 经
             agentscope-extensions-rag-simple 传递 poi-ooxml 5.5.1，若用 easyexcel 3.x（声明 poi 4.1.2），
             Maven nearest-wins 会裁出 poi 4.1.2 + poi-ooxml 5.5.1 的分裂 classpath，SXSSFWorkbook
             静态初始化直接 NoClassDefFoundError（实测踩过）。下面显式钉 poi/poi-ooxml 5.5.1，
             与 starter 侧完全对齐——同 commons-lang3 的覆盖手法，只在本模块生效。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>4.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- Skill 多存储目标：发布 SKILL.md 到 Nacos 配置中心（NacosSkillPublisher，publishConfig/removeConfig）。
             版本随根 pom 的 ${nacos.version} 属性（与 starter 侧一致），避免在本模块重复固定版本号。 -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>${nacos.version}</version>
        </dependency>

        <!-- Skill 多存储目标：发布 SKILL.md 到 SFTP 目录（SftpSkillPublisher）。mwiede/jsch 是 JSch 的
             社区维护版，保持 com.jcraft.jsch 包 API 兼容。 -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <version>${jsch.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.richard.fyoung.customeradmin.contentguard.jdbc.SensitiveWordHitLogExtMapper">

    <sql id="whereClause">
        <where>
            <if test="q.direction != null and q.direction != ''">
                AND direction = #{q.direction}
            </if>
            <if test="q.action != null and q.action != ''">
                AND action = #{q.action}
            </if>
            <if test="q.keyword != null and q.keyword != ''">
                AND words LIKE CONCAT('%', #{q.keyword}, '%')
            </if>
            <if test="q.sessionId != null and q.sessionId != ''">
                AND session_id = #{q.sessionId}
            </if>
            <if test="q.startMs != null">
                AND created_at_ms &gt;= #{q.startMs}
            </if>
            <if test="q.endMs != null">
                AND created_at_ms &lt;= #{q.endMs}
            </if>
        </where>
    </sql>

    <select id="findPage" resultType="com.richard.fyoung.customerwork.sensitiveword.entity.SensitiveWordHitLogEntity">
        SELECT id, direction, action, words, categories, hit_count, agent_name,
               session_id, user_id, snippet, created_at_ms
        FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
        ORDER BY id DESC
        LIMIT #{q.limit} OFFSET #{q.offset}
    </select>

    <select id="countBy" resultType="long">
        SELECT COUNT(*) FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
    </select>

    <select id="countByAction" resultType="com.richard.fyoung.customeradmin.contentguard.jdbc.ContentGuardCountRow">
        SELECT action AS label, COUNT(*) AS total
        FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
        GROUP BY action
    </select>

    <select id="countByDirection" resultType="com.richard.fyoung.customeradmin.contentguard.jdbc.ContentGuardCountRow">
        SELECT direction AS label, COUNT(*) AS total
        FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
        GROUP BY direction
    </select>

    <select id="topWords" resultType="com.richard.fyoung.customeradmin.contentguard.jdbc.ContentGuardCountRow">
        SELECT words AS label, COUNT(*) AS total
        FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
        GROUP BY words
        ORDER BY total DESC
        LIMIT #{topN}
    </select>

    <!-- dateFormat 由服务层从固定枚举映射而来（按天/按小时两种），不接受外部任意串，不存在注入面 -->
    <select id="trend" resultType="com.richard.fyoung.customeradmin.contentguard.jdbc.ContentGuardCountRow">
        SELECT DATE_FORMAT(FROM_UNIXTIME(created_at_ms / 1000), #{dateFormat}) AS label,
               COUNT(*) AS total
        FROM cw_sensitive_word_hit_log
        <include refid="whereClause"/>
        GROUP BY label
        ORDER BY label ASC
    </select>
</mapper>

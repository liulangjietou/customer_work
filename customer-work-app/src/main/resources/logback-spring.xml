<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台输出包含 requestId（MDC）。
  需要结构化 JSON 日志时：引入 net.logstash.logback:logstash-logback-encoder，
  把 CONSOLE 的 encoder 换成 <encoder class="net.logstash.logback.encoder.LogstashEncoder"/> 即可。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] [%X{sessionId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.richardfyoung</groupId>
        <artifactId>customer-work-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>customer-work-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>customer-work-spring-boot-starter</name>
    <description>可复用的 AgentScope 智能体能力：模型层/记忆/RAG/工具SPI/会话/可观测/安全/Nacos 等</description>

    <dependencies>
        <!-- WebFlux + 校验：Filter/Reactor 能力（接入层安全过滤器在本模块） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI（OpenApiConfig 在本模块） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- 可观测：健康 / 指标 / Prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 会话持久化：HikariCP 连接池 + MySQL 驱动。
             用 HikariCP 而非 spring-boot-starter-jdbc，避免引入 spring-jdbc 触发
             DataSourceAutoConfiguration（否则下游需配 spring.datasource.url 或排除它）。 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <!-- 业务持久层 ORM：MyBatis-Plus（版本对齐 customer-admin-server 的 3.5.7）。
             刻意用 mybatis-plus（extension 聚合，非 mybatis-plus-spring-boot3-starter），不触发官方
             MybatisPlusAutoConfiguration/DataSourceAutoConfiguration——本 starter 全部显式命名装配
             （CustomerWorkPersistenceConfig 独立 DataSource/SqlSessionFactory/SqlSessionTemplate + @MapperScan Ref 绑定），
             对 WebFlux 宿主与下游自有 MyBatis 环境零干扰。spring-jdbc 由其传递引入（SqlSessionTemplate 事务基础），
             此处显式声明以示意图；DataSourceAutoConfiguration 由宿主 spring.autoconfigure.exclude 关闭。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- mybatis-plus 里的 mybatis-spring 是 optional(2.1.2, Spring5)，不传递；Boot 3(Spring 6) 需显式引入
             mybatis-spring 3.0.x（与官方 mybatis-plus-spring-boot3-starter 3.5.7 对齐用 3.0.3），
             提供 SqlSessionTemplate / @MapperScan / MapperScannerConfigurer 等 jakarta 版实现。 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- 长期记忆 Mem0/ReMe 客户端依赖 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>${nacos.version}</version>
        </dependency>

        <!-- AgentScope Java 2.0 Harness（含 agentscope-core：Agent/Model/Tool/Middleware/State/Skill/RAG/Memory/Permission/Sandbox/Subagent/PlanMode/Compaction） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- 2.0.0 GA 起，内置模型实现从 agentscope-core 拆成独立扩展模块（io.agentscope.core.model.*
             -> io.agentscope.extensions.model.{provider}.*，RC4 -> GA 升级踩的坑），ModelConfig 五个
             厂商分支都要显式声明依赖，版本由父 pom 引入的 agentscope-bom 统一管理，这里不写版本号。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-gemini</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-ollama</artifactId>
        </dependency>

        <!-- 会话/状态持久化：AgentStateStore 的 Redis / MySQL 实现（替代 1.x 的 session.redis/mysql） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-mysql</artifactId>
        </dependency>

        <!-- 定时任务调度：把 Agent 注册为 XXL-JOB JobHandler，周期/启停/重试交给 XXL-JOB 控制台管理。
             版本由父 pom 引入的 agentscope-bom 统一管理，这里不写版本号。scheduler-common 是
             scheduler-xxl-job 自身 pom 里的 provided 依赖（不会传递），用到其 RuntimeAgentConfig /
             ScheduleConfig / AgentScheduler 等类需显式声明。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-scheduler-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-scheduler-xxl-job</artifactId>
        </dependency>
        <!-- xxl-job-core：agentscope-bom 未管理其版本（仅托管 io.agentscope 自身制品），需显式声明。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>3.3.2</version>
        </dependency>

        <!-- 长期记忆扩展：Mem0 / ReMe / 百炼 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-mem0</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-reme</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-memory-bailian</artifactId>
        </dependency>

        <!-- RAG 知识库扩展：简单内存 / Dify / 百炼 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-rag-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-rag-dify</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-rag-bailian</artifactId>
        </dependency>

        <!-- 协议 / 网关 / 观测扩展：AG-UI / Higress / Studio / Nacos 提示词 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-agui</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-higress</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-studio</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-nacos-prompt</artifactId>
        </dependency>

        <!-- 仅取密码哈希工具（BCryptPasswordEncoder，用户账户密码加密），不引入
             spring-boot-starter-security 的自动装配（会拦截 WebFlux 端点）；版本随
             spring-boot-starter-parent 统一管理，与 customer-admin-server 保持一致。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

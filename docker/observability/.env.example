# =============================================================================
# 监控栈环境变量样例：复制为 .env 后按需修改。
#   cp .env.example .env
# .env 不进仓库（真实 webhook/密码属于敏感信息），本文件只放占位值。
# =============================================================================

# ---------------- Grafana ----------------
# 管理员密码（首次启动生效；改密后重启容器不会覆盖已改的密码，除非删数据卷重来）
GRAFANA_ADMIN_PASSWORD=admin

# Grafana MySQL 数据源（只读用途：读 cw_agent_call_log 做 Top10 报表面板）。
# 生产务必单独建一个只读账号（GRANT SELECT），不要直接用 root——本地开发默认沿用 root/root 图省事。
GRAFANA_MYSQL_HOST=host.docker.internal
GRAFANA_MYSQL_PORT=3306
GRAFANA_MYSQL_DATABASE=agent_scope_customer_work
GRAFANA_MYSQL_USER=root
GRAFANA_MYSQL_PASSWORD=root

# ---------------- 钉钉群机器人 Webhook ----------------
# 钉钉群 -> 群设置 -> 智能群助手 -> 添加机器人 -> 自定义(Webhook)，复制 Webhook 地址填在这里。
# 若机器人启用了"加签"校验，签名密钥需另外改 dingtalk/config.yml 里的 secret 字段（见该目录说明）。
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME

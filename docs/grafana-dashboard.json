{
  "__comment": "示例 Grafana 仪表盘：基于本项目 Micrometer/Prometheus 指标。导入后选择 Prometheus 数据源。",
  "title": "AgentScope 智能客服 - Agent 概览",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "请求数 (req/min)",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(customerwork_agent_requests_total[1m]) * 60"}
      ]
    },
    {
      "title": "工具调用 (按工具)",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (tool) (rate(customerwork_agent_tool_calls_total[5m]))"}
      ]
    },
    {
      "title": "错误数",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(customerwork_agent_errors_total[5m])"}
      ]
    },
    {
      "title": "累计 Token 消耗（成本）",
      "type": "stat",
      "targets": [
        {"expr": "customerwork_agent_tokens_total"}
      ]
    },
    {
      "title": "JVM 堆内存",
      "type": "timeseries",
      "targets": [
        {"expr": "jvm_memory_used_bytes{area=\"heap\"}"}
      ]
    }
  ]
}

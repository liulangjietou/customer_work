<?xml version="1.0" encoding="UTF-8"?>
<!--
  rc2.0 迁移专用 Maven settings：复用本机已有依赖缓存（含 agentscope 2.0.0-RC4），
  去除会拦截 Maven Central 的 external:* 镜像，未命中缓存时直连 Central 兜底。
  仅本次构建使用：mvn -s scripts/settings-rc2.xml ...，不影响全局 ~/.m2/settings.xml。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <localRepository>/Users/zhangfuqiang/mavenjar</localRepository>

    <profiles>
        <profile>
            <id>central-direct</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>central-direct</activeProfile>
    </activeProfiles>
</settings>

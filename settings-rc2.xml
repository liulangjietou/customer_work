<?xml version="1.0" encoding="UTF-8"?>
<!--
  rc2.0 迁移用可移植 Maven settings：直连 Maven Central、去除会拦截 Central 的 external:* 镜像。
  仅本次构建使用，不影响全局 ~/.m2/settings.xml：

      mvn -s settings-rc2.xml clean test

  说明：本机若已为日常工作在 ~/.m2/settings.xml 配置了 external:* 镜像（如内网 nexus / 已停服的镜像），
  会拦截 Maven Central 导致 2.0.0-RC4 传递依赖拉取失败；本文件用默认本地仓库 + 直连 Central 兜底。
  如需复用本机其它本地仓库以加速，可自行加 <localRepository>…</localRepository>。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <profiles>
        <profile>
            <id>central-direct</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>central-direct</activeProfile>
    </activeProfiles>
</settings>
